# Samaj monolith (BackendServiceV2/samaj default port 8080). Use gateway URL if you proxy instead.
VITE_API_URL=http://192.168.1.8:8080

# Admin: show /admin/kyc in sidebar and route (requires USERS permission like User Management). Default off until KYC backend exists.
# VITE_ADMIN_KYC_ENABLED=true

# Google Sign-In: Web OAuth Client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
